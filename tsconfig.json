{
  "extends": "./.config/tsconfig.json",
  "include": [
    "src",
    "types"
  ],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "react",
    "rootDir": "./src",
    "baseUrl": "./src",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "noImplicitAny": false,
    "allowJs": true,
    "outDir": "$$ts-jest$$"
  },
  "exclude": [
    "public",
    "dist",
    "node_modules"
  ],
}