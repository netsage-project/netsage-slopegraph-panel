{
  "name": "netsage-slopegraph-panel",
  "version": "1.2.0",
  "description": "Slope Graph Panel",
  "repository": "https://github.com/netsage-project/netsage-slopegraph-panel",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test -c \"unit tests/playwright.config.ts\"",
    "e2e:ui": "playwright test -c \"unit tests/playwright.config.ts\" --ui",
    "lint": "eslint --cache --ignore-path ./.gitignore --ignore-pattern src/d3.min.js --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn run lint --fix",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "yarn watch",
    "test": "jest -c \"unit tests/jest.config.js\" --watch --onlyChanged",
    "test:ci": "jest -c \"unit tests/jest.config.js\" --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": "Netsage",
  "email": "khturner2@es.net",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.10.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin-ts": "^3.1.0",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "d3": "^7.4.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^4.2.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.5",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.1.0",
    "typescript": "~6.0.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^13.1.0",
    "@grafana/runtime": "^13.1.0",
    "@grafana/ui": "^13.1.0",
    "d3": "^7.4.0",
    "grafana-plugin-support": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1"
  },
  "packageManager": "yarn@1.22.10"
}
